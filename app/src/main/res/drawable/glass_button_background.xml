<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_purple"
                android:centerColor="@color/glass_purple_bright"
                android:endColor="@color/glass_purple"
                android:angle="0"/>
            <corners android:radius="16dp" />
            <stroke android:width="1.2dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</ripple>
