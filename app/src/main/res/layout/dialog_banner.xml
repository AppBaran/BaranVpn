<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/banner_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="#1A1F28"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ProgressBar
                android:id="@+id/banner_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/purple_600" />

            <!-- bottom gradient + actions only (no title) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/banner_bottom_scrim"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/banner_skip"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/close"
                        android:textColor="#CCFFFFFF"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/banner_open"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/view"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/purple_600"
                        android:visibility="gone"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Large red close button (top-end) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/banner_close"
                style="@style/Widget.Material3.Button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="52dp"
                android:minHeight="52dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@color/red"
                app:cornerRadius="26dp"
                app:elevation="6dp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
