<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/purple_600</item>
        <item name="colorOnPrimary">@color/on_hero</item>
        <item name="colorPrimaryContainer">@color/purple_900</item>
        <item name="colorOnPrimaryContainer">@color/purple_100</item>
        <item name="colorSecondary">@color/purple_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/purple_800</item>
        <item name="colorOnSecondaryContainer">@color/purple_100</item>
        <item name="colorTertiary">@color/purple_200</item>
        <item name="colorOnTertiary">@color/purple_900</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/purple_900</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/purple_200</item>
        <item name="colorOutline">@color/glass_purple</item>
        <item name="colorOutlineVariant">@color/purple_800</item>
        <item name="android:fontFamily">@font/vazir</item>
        <item name="fontFamily">@font/vazir</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Dropdown & TextInput specific overrides -->
        <item name="boxStrokeColor">@color/glass_purple</item>
        <item name="boxStrokeWidth">1.5dp</item>
